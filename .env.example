# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# SerpAPI — real Google search results (100/month free, then $50/mo for 5k)
# Sign up at https://serpapi.com → Dashboard → API Key
SERPAPI_KEY=your_key_here

# Serper.dev — faster/cheaper alternative to SerpAPI (2,500/month free)
# Sign up at https://serper.dev → API Key
SERPER_API_KEY=your_key_here

# Google Custom Search API — alternative/supplement to SerpAPI (100/day free, then $5/1000)
# Step 1: https://programmablesearchengine.google.com → New → "Search the entire web" → copy Search Engine ID
# Step 2: https://console.cloud.google.com → APIs & Services → Enable "Custom Search API" → Credentials → Create API Key
GOOGLE_SEARCH_API_KEY=your_key_here
GOOGLE_SEARCH_CX=your_search_engine_id_here

# Supabase — persistent query cache (saves Serper quota on repeat analyses)
# Free tier: 500MB storage, plenty for thousands of cached queries
# Setup:
#   1. Create project at supabase.com
#   2. Run this SQL in the Supabase SQL editor:
#
#      create table if not exists serper_cache (
#        query      text primary key,
#        results    jsonb not null,
#        cached_at  timestamptz not null default now()
#      );
#      create index if not exists serper_cache_cached_at on serper_cache (cached_at);
#
#   3. Settings → API → copy "Project URL" and "service_role" secret key
SUPABASE_URL=your_project_url_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
